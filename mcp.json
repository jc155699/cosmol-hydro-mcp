{
  "mcpServers": {
    "cosmol-hydrogeo-uvx": {
      "command": "uvx",
      "args": ["cosmol-hydrogeo-mcp"],
      "env": {
        "COSMOL_HYDRO_URL": "https://hydro.cosmolsesc.com",
        "COSMOL_API_TOKEN": ""
      }
    },
    "cosmol-hydrogeo-npx": {
      "command": "npx",
      "args": ["-y", "@cosmol/hydrogeo-mcp"],
      "env": {
        "COSMOL_HYDRO_URL": "https://hydro.cosmolsesc.com",
        "COSMOL_API_TOKEN": ""
      }
    },
    "cosmol-hydrogeo-python": {
      "command": "python3",
      "args": ["cosmol_hydro_mcp.py"],
      "env": {
        "COSMOL_HYDRO_URL": "https://hydro.cosmolsesc.com",
        "COSMOL_API_TOKEN": ""
      }
    },
    "cosmol-hydrogeo-remote": {
      "type": "http",
      "url": "https://hydro.cosmolsesc.com/mcp"
    }
  }
}
